# MongoDB provisioned by Emergent
MONGO_URL=mongodb://HOST:27017
DB_NAME=biz_transpay

# Authentication and encryption - use independent random production values
JWT_SECRET=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=168
SESSION_SECRET=replace-with-a-different-long-random-value
SECRETS_ENCRYPTION_KEY=replace-with-a-stable-fernet-compatible-key

# Public production URL and browser security
OFFICIAL_DOMAIN=https://pay.example.com
CORS_ORIGINS=https://pay.example.com
CSRF_TRUSTED_ORIGINS=https://pay.example.com
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
CLOUDFLARE_TURNSTILE_ALLOWED_HOSTNAMES=pay.example.com

# Trusted proxy / application limits
ADMIN_ALLOWED_IPS=
ADMIN_TRUST_PROXY_HEADERS=true
EDGE_BLOCKED_IPS=
EDGE_TRUST_PROXY_HEADERS=true
MAX_REQUEST_BYTES=12582912
MAX_WEBHOOK_BYTES=2097152
FORWARDED_ALLOW_IPS=*

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Keep false on horizontally scaled Preview/Production environments. Sending
# alerts remains enabled; only interactive getUpdates command polling stops.
TELEGRAM_COMMAND_POLLING_ENABLED=false

# PayDunya
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_TEST_CUSTOMER_EMAIL=
PAYDUNYA_TEST_CUSTOMER_PASSWORD=
PAYDUNYA_TEST_CUSTOMER_PHONE=

# FedaPay
FEDAPAY_SECRET_KEY=
FEDAPAY_PUBLIC_KEY=
FEDAPAY_WEBHOOK_SECRET=
FEDAPAY_BASE_URL=

# IzichangePay
IZIPAY_API_KEY=
IZIPAY_WEBHOOK_SECRET=
IZIPAY_BASE_URL=

# Mbiyo
MBIYO_API_KEY=
MBIYO_PUBLIC_KEY=
MBIYO_SECRET_KEY=
MBIYO_WEBHOOK_SECRET=

# Stripe (only when enabled)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=