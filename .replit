modules = ["nodejs-20", "python-3.12", "web", "bash", "postgresql-16"]

[nix]
channel = "stable-25_05"
packages = ["freetype", "gumbo", "harfbuzz", "jbig2dec", "libjpeg_turbo", "mupdf", "openjpeg", "postgresql", "swig", "xcbuild"]

[agent]
expertMode = true

[userenv]

[userenv.shared]
DB_NAME = "biz_transpay"
TELEGRAM_CHAT_ID = "7838456636"
PLATFORM_OWNER_EMAIL = "biztechsarlu@gmail.com"
PLATFORM_OWNER_CLAIM_BEFORE = "2026-09-17T08:16:53.140Z"

[env]
DB_NAME = "biz_transpay"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/start-replit.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 8000
externalPort = 8000

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[deployment]
deploymentTarget = "vm"
run = ["bash", "scripts/start-replit.sh"]
ignorePorts = false
build = ["bash", "-c", "python -m pip install --disable-pip-version-check --no-input --break-system-packages -r backend/requirements.txt"]
