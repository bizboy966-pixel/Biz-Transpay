modules = ["nodejs-20", "python-3.12", "bash", "web"]

[nix]
channel = "stable-25_05"
packages = ["mongodb"]

[agent]
expertMode = true

[userenv]

[userenv.shared]
DB_NAME = "biz_transpay"

[env]
MONGO_URL = "mongodb://127.0.0.1:27017"
DB_NAME = "biz_transpay"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/start-replit.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 8000
externalPort = 8000

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[deployment]
deploymentTarget = "vm"
run = ["bash", "scripts/start-replit.sh"]
