modules = ["nodejs-20", "python-3.12", "bash", "web"]

[nix]
channel = "stable-25_05"
packages = ["mongodb"]

[agent]
expertMode = true

[userenv]

[userenv.shared]
DB_NAME = "biz_transpay"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -lc 'mkdir -p .data/mongodb; if ! pgrep -x mongod >/dev/null; then mongod --dbpath .data/mongodb --bind_ip 127.0.0.1 --port 27017 --logpath .data/mongodb.log --logappend & fi; export MONGO_URL=mongodb://127.0.0.1:27017 DB_NAME=biz_transpay; (cd backend && python -m uvicorn server:app --host 0.0.0.0 --port 8000) & cd frontend && BROWSER=none PORT=5000 yarn start'"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 8000
